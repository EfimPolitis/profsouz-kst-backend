model Event {
  eventId     String           @id @unique @default(uuid())
  title       String           @unique
  description String
  organizer   String
  link        String
  date        DateTime         @default(now()) @db.Timestamp(2)
  places      Int
  status      EStatus          @default(EVERYONE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  application Application[]
  categories  CategoriesList[]
  images      EventImage[]
}

enum EStatus {
  INTERNAL
  EVERYONE
}
